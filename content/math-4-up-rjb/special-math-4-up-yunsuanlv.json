            {
              "id": "special-ex-006",
              "type": "blank",
              "question": "简便计算：999 × 222 + 333 × 334 = ______",
              "answer": "333000",
              "explanation": "把999拆成3×333，原式 = 333 × 3 × 222 + 333 × 334 = 333 × 666 + 333 × 334 = 333 × (666 + 334) = 333 × 1000 = 333000。",
              "knowledgePointIds": ["unit-math-4-up-rjb-p4::kp-formula-003"],
              "metadata": { "difficulty": "挑战" }
            },
            {
              "id": "special-ex-007",
              "type": "blank",
              "question": "已知 45 × 12 = 540，那么 45 × 24 = ______，45 × 6 = ______",
              "answer": "1080,270",
              "explanation": "24 = 12 × 2，所以 45 × 24 = 540 × 2 = 1080；6 = 12 ÷ 2，所以 45 × 6 = 540 ÷ 2 = 270。体现了乘法中因数的倍数关系。",
              "knowledgePointIds": ["unit-math-4-up-rjb-p4::kp-formula-002"],
              "metadata": { "difficulty": "挑战" }
            },
            {
              "id": "special-ex-008",
              "type": "single",
              "question": "小明计算 25 × 16 时，用了 25 × 4 × 4，这运用了什么运算律？",
              "options": ["A. 乘法交换律", "B. 乘法结合律", "C. 乘法分配律", "D. 加法结合律"],
              "answer": "B",
              "explanation": "把 16 拆成 4×4，相当于 (25×4)×4，运用了乘法结合律。",
              "knowledgePointIds": ["unit-math-4-up-rjb-p4::kp-formula-002"],
              "metadata": { "difficulty": "提高" }
            },
