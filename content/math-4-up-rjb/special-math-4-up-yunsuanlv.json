          "exercises": [
            {
              "id": "special-ex-001",
              "type": "blank",
              "question": "简便计算：125 × 25 × 32 = ______",
              "answer": "100000",
              "explanation": "把32拆成4×8，利用乘法交换律和结合律：125 × 25 × 4 × 8 = (125 × 8) × (25 × 4) = 1000 × 100 = 100000。",
              "knowledgePointIds": ["unit-math-4-up-rjb-p4::kp-formula-002"],
              "metadata": { "difficulty": "挑战" }
            },
            {
              "id": "special-ex-002",
              "type": "blank",
              "question": "简便计算：99 × 47 + 47 = ______",
              "answer": "4700",
              "explanation": "提取公因数47：47 × (99 + 1) = 47 × 100 = 4700。",
              "knowledgePointIds": ["unit-math-4-up-rjb-p4::kp-formula-003"],
              "metadata": { "difficulty": "挑战" }
            },
            {
              "id": "special-ex-003",
              "type": "single",
              "question": "计算 25 × 24 时，下面哪种方法不简便？",
              "options": ["A. 25 × 4 × 6", "B. 25 × (20 + 4)", "C. 25 × 20 × 4", "D. 25 × 8 × 3"],
              "answer": "C",
              "explanation": "25 × 20 × 4 = 500 × 4 = 2000，虽然算对了，但方法不简便（先算25×20没有凑整）。A 得 100×6=600；B 得 500+100=600；D 得 200×3=600。C 虽然结果错（应得600，写成2000），且方法不简便，所以C不正确。",
              "knowledgePointIds": ["unit-math-4-up-rjb-p4::kp-formula-003"],
              "metadata": { "difficulty": "挑战" }
            },
            {
              "id": "special-ex-004",
              "type": "blank",
              "question": "用简便方法计算：1 + 2 + 3 + ... + 99 + 100 = ______",
              "answer": "5050",
              "explanation": "利用加法交换律和结合律配对：(1+100) + (2+99) + ... + (50+51)，共50对，每对101，总数 = 101 × 50 = 5050。",
              "knowledgePointIds": ["unit-math-4-up-rjb-p4::kp-formula-001"],
              "metadata": { "difficulty": "挑战" }
            },
            {
              "id": "special-ex-005",
              "type": "single",
              "question": "与 78 × 102 - 78 × 2 结果相等的是：",
              "options": ["A. 78 × 100", "B. 78 × 102", "C. 78 × 104", "D. 78 × 98"],
              "answer": "A",
              "explanation": "提取公因数78：78 × (102 - 2) = 78 × 100 = 7800。",
              "knowledgePointIds": ["unit-math-4-up-rjb-p4::kp-formula-003"],
              "metadata": { "difficulty": "提高" }
            }
          ]
