  "knowledgePoints": [
    {
      "id": "kp-math-401",
      "type": "formula",
      "title": "积的变化规律与估算",
      "content": "一个乘数不变，另一个乘数乘几，积就乘几；一个乘数乘a，另一个乘数乘b，积就乘a×b。估算时通常把乘数看作整十、整百数。"
    },
    {
      "id": "kp-math-402",
      "type": "concept",
      "title": "乘法中的错中求解",
      "content": "根据乘数变化引起积的变化，反推原乘数。积的变化量 ÷ 乘数的变化量 = 不变的乘数。"
    },
    {
      "id": "kp-math-403",
      "type": "formula",
      "title": "数字谜与组数",
      "content": "利用乘法竖式的结构特点和数字范围，推理出每个汉字或符号代表的数字。组数时，为使乘积最大，应尽量让高位数字大，且两个乘数尽量接近。"
    },
    {
      "id": "kp-math-404",
      "type": "formula",
      "title": "乘法在实际问题中的应用",
      "content": "结合购物、分配方案、促销利润等实际情境，综合运用估算和精确计算解决实际问题。"
    }
  ],
