          ],
          "exercises": [
            {
              "id": "unit-math-4-up-rjb-p3::u4-ex-001",
              "type": "single",
              "question": "用4个同样大小的正方体搭成一个立体图形，从正面看到的形状是横着排成3个正方形。下面哪种搭法是不可能的？",
              "options": [
                "A. 底层3个，上层1个放在中间",
                "B. 底层3个，上层1个放在左边",
                "C. 底层3个，上层1个放在右边",
                "D. 底层4个，上层没有"
              ],
              "answer": "D",
