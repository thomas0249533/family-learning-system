          "exercises": [
            {
              "id": "unit-math-4-up-rjb-p3::u3-ex-014",
              "type": "blank",
              "question": "观察规律：1 × 1 = 1，11 × 11 = 121，111 × 111 = 12321。\\n那么 1111 × 1111 = （______），11111 × 11111 = （______）。",
              "answer": "1234321,123454321",
              "explanation": "规律是：由几个1组成的数相乘，积是从1开始递增到几，再递减回1。1111 × 1111 有4个1，所以积是1234321；11111 × 11111 有5个1，所以积是123454321。",
              "knowledgePointIds": [
                "unit-math-4-up-rjb-p3::kp-num-007"
              ],
              "metadata": {
                "difficulty": "提高"
              }
            },
            {
              "id": "unit-math-4-up-rjb-p3::u3-ex-015",
              "type": "blank",
              "question": "观察规律：9 × 9 = 81，99 × 99 = 9801，999 × 999 = 998001。\\n那么 9999 × 9999 = （______）。",
              "answer": "99980001",
              "explanation": "规律是：n个9乘n个9，结果由(n-1)个9，接着一个8，接着(n-1)个0，最后是一个1组成。9999 × 9999，n=4，所以是3个9（999），一个8，3个0（000），一个1，即99980001。",
              "knowledgePointIds": [
                "unit-math-4-up-rjb-p3::kp-num-007"
              ],
              "metadata": {
                "difficulty": "挑战"
              }
            },
