              "question": "简便计算：125 × 88 = ______",
              "answer": "11000",
              "explanation": "把88拆成8×11：125 × 8 × 11 = 1000 × 11 = 11000。",
              "knowledgePointIds": ["unit-math-4-up-rjb-p4::kp-formula-002"],
              "metadata": { "difficulty": "提高" }
            },
