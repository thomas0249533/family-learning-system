            },
            {
              "id": "sprint-ex-002",
              "type": "single",
              "question": "某数四舍五入到万位是 7 万，这个数最大是：",
              "options": ["A. 69999", "B. 74999", "C. 75000", "D. 79999"],
              "answer": "B",
              "explanation": "四舍五入到万位为7万，原数最大时万位为7，千位最大取4（否则进位成8万），其余各位取9，即74999。",
              "knowledgePointIds": ["unit-math-4-up-rjb-p1::kp-num-003"],
              "metadata": { "difficulty": "提高" }
