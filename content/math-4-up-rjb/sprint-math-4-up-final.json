              "id": "sprint-ex-007",
              "type": "single",
              "question": "一辆汽车 3 小时行驶 240 千米。照这样计算，行驶 640 千米需要多少小时？",
              "options": ["A. 6 小时", "B. 7 小时", "C. 8 小时", "D. 9 小时"],
              "answer": "C",
              "explanation": "先求速度：240 ÷ 3 = 80（千米/时）。再求时间：640 ÷ 80 = 8（小时）。",
              "knowledgePointIds": ["unit-math-4-up-rjb-p5::kp-rel-001"],
              "metadata": { "difficulty": "提高" }
            },
