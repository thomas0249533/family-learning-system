  "knowledgePoints": [
    {
      "id": "kp-sym-001",
      "type": "concept",
      "title": "轴对称与对称轴",
      "content": "把一个图形沿一条直线对折，两侧能完全重合，这个图形就是轴对称图形，这条直线叫对称轴。\n常见对称轴条数：长方形 2 条，正方形 4 条，等腰三角形 1 条，等边三角形 3 条，等腰梯形 1 条，圆有无数条。\n平行四边形（一般的）不是轴对称图形。",
      "prerequisites": [],
      "metadata": {
        "difficulty": "基础",
        "estimatedMinutes": 15,
        "cognitiveLevel": "观察",
        "ability": "空间观念",
        "tags": [
          "轴对称",
          "对称轴"
        ]
      }
    },
    {
      "id": "kp-sym-002",
      "type": "concept",
      "title": "平移与旋转",
      "content": "平移：图形沿直线移动，**形状、大小、方向都不变，只有位置变了**。\n旋转：图形绕一个点（或轴）转动，方向会改变。\n数平移格数的方法：找一个对应点，数它移动了几格。",
      "prerequisites": [],
      "metadata": {
        "difficulty": "基础",
        "estimatedMinutes": 15,
        "cognitiveLevel": "观察",
        "ability": "空间观念",
        "tags": [
          "平移",
          "旋转"
        ]
      }
    }
  ],
