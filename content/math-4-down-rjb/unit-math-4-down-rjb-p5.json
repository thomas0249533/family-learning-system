  "knowledgePoints": [
    {
      "id": "kp-tri-001",
      "type": "concept",
      "title": "三角形的特性与三边关系",
      "content": "三角形有 3 条边、3 个角、3 个顶点；三角形具有稳定性（不容易变形）。\n三边关系：三角形任意两边的和大于第三边。判断三条线段能否围成三角形，只要看**较短两边之和**是否大于最长边即可。\n推论：两边之差小于第三边。",
      "prerequisites": [],
      "metadata": {
        "difficulty": "基础",
        "estimatedMinutes": 15,
        "cognitiveLevel": "理解",
        "ability": "空间观念",
        "tags": [
          "三角形",
          "三边关系"
        ]
      }
    },
    {
      "id": "kp-tri-002",
      "type": "concept",
      "title": "三角形的分类与内角和",
      "content": "按角分：锐角三角形（三个角都是锐角）、直角三角形（有一个直角）、钝角三角形（有一个钝角）。\n按边分：不等边三角形、等腰三角形（两条边相等，两个底角相等）、等边三角形（三条边都相等，三个角都是 60°）。\n三角形的内角和是 180°。等边三角形也是等腰三角形（特殊的一种）。",
      "prerequisites": [],
      "metadata": {
        "difficulty": "基础",
        "estimatedMinutes": 15,
        "cognitiveLevel": "理解",
        "ability": "空间观念",
        "tags": [
          "分类",
          "内角和"
        ]
      }
    },
    {
      "id": "kp-tri-003",
      "type": "concept",
      "title": "四边形的内角和",
      "content": "四边形可以分成两个三角形，所以内角和是 180°×2＝360°。\n推广：多边形内角和 = (边数－2)×180°。例如五边形是 540°，六边形是 720°。",
      "prerequisites": [],
      "metadata": {
        "difficulty": "基础",
        "estimatedMinutes": 15,
        "cognitiveLevel": "推理",
        "ability": "推理能力",
        "tags": [
          "内角和",
          "多边形"
        ]
      }
    }
  ],
