  "knowledgePoints": [
    {
      "id": "kp-law-001",
      "type": "concept",
      "title": "加法交换律与结合律",
      "content": "加法交换律：两个数相加，交换加数的位置，和不变。a＋b＝b＋a。\n加法结合律：三个数相加，先把前两个数相加，或者先把后两个数相加，和不变。(a＋b)＋c＝a＋(b＋c)。\n用法：把能凑成整十、整百的数放在一起算。",
      "prerequisites": [],
      "metadata": {
        "difficulty": "基础",
        "estimatedMinutes": 15,
        "cognitiveLevel": "理解",
        "ability": "运算能力",
        "tags": [
          "加法运算律",
          "简便计算"
        ]
      }
    },
    {
      "id": "kp-law-002",
      "type": "concept",
      "title": "乘法交换律、结合律与分配律",
      "content": "乘法交换律：a×b＝b×a。\n乘法结合律：(a×b)×c＝a×(b×c)。\n乘法分配律：(a＋b)×c＝a×c＋b×c，反过来 a×c＋b×c＝(a＋b)×c 也成立。\n凑整口诀：25×4＝100，125×8＝1000，这两对最常用。",
      "prerequisites": [],
      "metadata": {
        "difficulty": "基础",
        "estimatedMinutes": 15,
        "cognitiveLevel": "理解",
        "ability": "运算能力",
        "tags": [
          "乘法运算律",
          "凑整"
        ]
      }
    },
    {
      "id": "kp-law-003",
      "type": "concept",
      "title": "运用运算定律简便计算",
      "content": "简便计算的核心是“凑整”：先用交换律、结合律把能凑成 10、100、1000 的数凑到一起。\n常见变形：\n· 99×a＋a 看成 (99＋1)×a；\n· a×102 看成 a×(100＋2)；\n· 连减看成减两数之和：a－b－c＝a－(b＋c)；\n· 连除看成除以两数之积：a÷b÷c＝a÷(b×c)。",
      "prerequisites": [],
      "metadata": {
        "difficulty": "提高",
        "estimatedMinutes": 15,
        "cognitiveLevel": "应用",
        "ability": "运算能力",
        "tags": [
          "简便计算"
        ]
      }
    }
  ],
