  "knowledgePoints": [
    {
      "id": "kp-obs-001",
      "type": "concept",
      "title": "从不同方向观察同一物体",
      "content": "观察物体时，站的位置不同，看到的形状可能不同，也可能相同。\n从一个位置观察长方体（或由小正方体摆成的立体图形），最多能看到 3 个面，最少看到 1 个面。\n从正面、上面、左面看到的图形，分别叫正面图、上面图、左面图。",
      "prerequisites": [],
      "metadata": {
        "difficulty": "基础",
        "estimatedMinutes": 15,
        "cognitiveLevel": "观察",
        "ability": "空间观念",
        "tags": [
          "观察物体"
        ]
      }
    },
    {
      "id": "kp-obs-002",
      "type": "concept",
      "title": "根据视图还原立体图形",
      "content": "给出几个方向的视图，可以推断立体图形最少/最多用几个小正方体。\n方法：把“从上面看”的图形当作地面摆放图，再看正面图和左面图决定每一列的高度。\n注意“至少”两个字：只要能摆出这个视图就行，不必把所有可能都摆满。",
      "prerequisites": [],
      "metadata": {
        "difficulty": "提高",
        "estimatedMinutes": 15,
        "cognitiveLevel": "推理",
        "ability": "空间观念",
        "tags": [
          "三视图",
          "搭积木"
        ]
      }
    }
  ],
