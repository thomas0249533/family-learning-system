  "knowledgePoints": [
    {
      "id": "kp-dec-001",
      "type": "concept",
      "title": "小数的意义与数位顺序",
      "content": "把单位“1”平均分成 10 份、100 份、1000 份……表示这样的一份或几份，可以用小数表示。\n小数点右边第一位是十分位（计数单位 0.1），第二位是百分位（计数单位 0.01），第三位是千分位（计数单位 0.001）。\n每相邻两个计数单位之间的进率都是 10。",
      "prerequisites": [],
      "metadata": {
        "difficulty": "基础",
        "estimatedMinutes": 15,
        "cognitiveLevel": "理解",
        "ability": "运算能力",
        "tags": [
          "小数",
          "数位",
          "计数单位"
        ]
      }
    },
    {
      "id": "kp-dec-002",
      "type": "concept",
      "title": "小数的性质与大小比较",
      "content": "小数的性质：小数的末尾添上 0 或去掉 0，小数的大小不变。例如 0.5＝0.50＝0.500。\n注意只有“末尾”的 0 能去掉，小数点后面中间的 0 不能动（0.05≠0.5）。\n比较大小：先比整数部分，整数部分大的就大；整数部分相同，从十分位起一位一位往下比。",
      "prerequisites": [],
      "metadata": {
        "difficulty": "基础",
        "estimatedMinutes": 15,
        "cognitiveLevel": "理解",
        "ability": "运算能力",
        "tags": [
          "小数性质",
          "比较大小"
        ]
      }
    },
    {
      "id": "kp-dec-003",
      "type": "concept",
      "title": "小数点位置移动引起小数大小的变化",
      "content": "小数点向右移动一位、两位、三位……小数就扩大到原来的 10 倍、100 倍、1000 倍……\n小数点向左移动一位、两位、三位……小数就缩小到原来的 1/10、1/100、1/1000……\n位数不够时用 0 补足，例如 3 的小数点向左移动两位是 0.03。",
      "prerequisites": [],
      "metadata": {
        "difficulty": "基础",
        "estimatedMinutes": 15,
        "cognitiveLevel": "应用",
        "ability": "运算能力",
        "tags": [
          "小数点移动"
        ]
      }
    },
    {
      "id": "kp-dec-004",
      "type": "concept",
      "title": "名数改写与求近似数",
      "content": "低级单位改写成高级单位要除以进率，高级单位改写成低级单位要乘进率。\n常用进率：1 米＝100 厘米，1 千米＝1000 米，1 千克＝1000 克，1 元＝10 角＝100 分。\n求近似数用“四舍五入”：保留两位小数就看千分位，精确到个位就看十分位。\n注意：表示近似数时，小数末尾的 0 不能去掉（3.75 精确到百分位，写 3.8 就变了精度）。",
      "prerequisites": [],
      "metadata": {
        "difficulty": "基础",
        "estimatedMinutes": 15,
        "cognitiveLevel": "应用",
        "ability": "运算能力",
        "tags": [
          "名数改写",
          "四舍五入"
        ]
      }
    }
  ],
