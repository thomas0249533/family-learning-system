  "knowledgePoints": [
    {
      "id": "kp-dadd-001",
      "type": "concept",
      "title": "小数加减法的计算法则",
      "content": "计算小数加减法，先把**小数点对齐**（也就是相同数位对齐），再按整数加减法的方法计算，最后在得数里对齐横线上的小数点位置点上小数点。\n得数末尾有 0 的要化简；位数不够时用 0 补足，例如 10－4.6 可以看成 10.0－4.6。",
      "prerequisites": [],
      "metadata": {
        "difficulty": "基础",
        "estimatedMinutes": 15,
        "cognitiveLevel": "理解",
        "ability": "运算能力",
        "tags": [
          "小数加法",
          "小数减法"
        ]
      }
    },
    {
      "id": "kp-dadd-002",
      "type": "concept",
      "title": "小数加减混合运算与简便计算",
      "content": "运算顺序与整数相同：同级从左往右，有括号先算括号里的。\n整数加法运算律对小数同样适用，凑整思路也一样：\n· 8.7＋5.9＋1.3 先算 8.7＋1.3＝10；\n· 12.5－3.6－6.4 看成 12.5－(3.6＋6.4)。",
      "prerequisites": [],
      "metadata": {
        "difficulty": "提高",
        "estimatedMinutes": 15,
        "cognitiveLevel": "应用",
        "ability": "运算能力",
        "tags": [
          "简便计算",
          "混合运算"
        ]
      }
    }
  ],
