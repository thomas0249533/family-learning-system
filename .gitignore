# 依赖
node_modules/
# 构建产物
dist/
# 打包前把 dist 挪走的临时目录（tauri build 会再跑一次 vite，避免 safe-delete 拦 bulk 删除）
.dist-prev/
dist-ssr/
.vite/
# Rust / Tauri 构建产物与打包
src-tauri/target/
src-tauri/gen/
# Tauri 签名密钥（含私钥，严禁入库）
.tauri/
# 根目录手工打包的 exe（本项目不纳入版本库）
/*.exe
# 临时脚本
*.tmp*
.tmp-*
# 环境
*.local
.env
.env.*
!.env.example
# 日志
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
# 测试缓存 / 覆盖率
.vitest-cache/
coverage/
# 编辑器 / 系统
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
# 视觉回归产物（截图留档需提交，故仅忽略临时 diff 输出）
tests/e2e/**/*-diff.png
test-results/
playwright-report/
# vite/vitest 解析配置时落在仓库根的临时 mjs（不是源码）
*.config.ts.timestamp-*.mjs

# V1.11 · F1 e2e 临时产物目录（默认 test-results/ 会被 safe-delete 拦 bulk 删除，改用自定义 output）
.pw-ai-out/
.dist-prev-v*/
mock-update/
# 家长原始资料（体积大、非产物，不入库）
content/资料/
