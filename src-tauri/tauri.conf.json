{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "FamilyLearningSystem",
  "version": "2.11.0",
  "identifier": "com.family.learning",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "家庭学习系统",
        "width": 1400,
        "height": 1000,
        "minWidth": 1000,
        "minHeight": 700,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU0ODE1MzY5NDNDREFCNzgKUldSNHE4MURhVk9CVkk2S3ZvaHF5TFhuZWxldHNVVHYyWElraVNOdDkvK3Y2d3RwdFpReVlRejYK",
      "endpoints": [
        "https://raw.githubusercontent.com/thomas0249533/family-learning-system/main/latest.json",
        "https://cdn.jsdelivr.net/gh/thomas0249533/family-learning-system@main/latest.json",
        "https://raw.gitmirror.com/thomas0249533/family-learning-system/main/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}